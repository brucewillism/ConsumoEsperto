# =============================================================================
# GITIGNORE - CONSUMO ESPERTO
# =============================================================================

# Ferramentas locais (não versionar)
tools/
!tools/.gitkeep

# Arquivos temporários
*.tmp
*.temp
*.log
*.sql
!backend/src/main/resources/db/migration/*.sql

# Downloads temporários
%TEMP%/
temp/

# Arquivos de configuração local
.env
application-local.properties

# Logs e relatorios locais (podem conter dados sensiveis)
logs/
backend/target/surefire-reports/
backend/target-verify-log*.txt
backend/backups/

# Arquivos de build
target/
dist/
node_modules/

# Artefatos do Playwright (E2E)
e2e/playwright-report/
e2e/test-results/

# Arquivos de IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Arquivos do sistema
.DS_Store
Thumbs.db

# Arquivos de backup
*.bak
*.backup
*.old
*.dump

# Arquivos de configuração PostgreSQL
*.conf
*.pid
*.lock

# Arquivos de configuração NGROK
ngrok.yml
ngrok-config.yml
