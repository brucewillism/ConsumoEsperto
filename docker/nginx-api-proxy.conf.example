# Exemplo — proxy HTTPS (host) → Spring Boot :8087
#
# O TLS termina aqui. Sem X-Forwarded-Proto $scheme o Spring vê HTTP e os
# filtros de ingestão respondem 403 HTTPS obrigatório (Atalhos / MacroDroid).
#
# NÃO use $http_x_forwarded_proto: o iPhone não envia esse header.

server {
    listen 443 ssl http2;
    server_name consumoesperto.brucew07.com.br;

    # ssl_certificate     /etc/letsencrypt/live/consumoesperto.brucew07.com.br/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/consumoesperto.brucew07.com.br/privkey.pem;

    location /api/ {
        proxy_pass         http://127.0.0.1:8087;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_read_timeout 360s;
    }

    location / {
        proxy_pass         http://127.0.0.1:8181;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    }
}
