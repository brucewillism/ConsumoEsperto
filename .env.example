# Copie para .env e ajuste (nunca commite o .env com segredos reais).
# Documentação: README.md · CONFIGURACAO_AMBIENTE.md · docs/WHATSAPP_EVOLUTION.md
#
# ROTACAO OBRIGATORIA (se credenciais ja foram expostas em Git/logs):
#   1. PostgreSQL: ALTER USER ... PASSWORD '...'  (use segredo novo gerado offline)
#   2. JWT_SECRET: gere string >= 64 chars e reinicie o backend (invalida tokens antigos)
#   3. Atualize .env local e secrets do CI/deploy — nunca commite o valor novo
#   4. Historico Git permanece comprometido ate limpeza autorizada (nao reescreva sem aprovacao)

DATABASE_URL=jdbc:postgresql://localhost:5432/consumoesperto
DATABASE_USERNAME=consumo
DATABASE_PASSWORD=mude_isto

# Aliases usados por Docker Compose (integracao-postgres.ps1 aceita ambos)
POSTGRES_USER=consumo
POSTGRES_PASSWORD=mude_isto

JWT_SECRET=mude_para_uma_string_longa_e_aleatoria_com_pelo_menos_64_caracteres_para_hs512

# Evolution API em Node (tools/evolution-api ou EVOLUTION_DIR).
EVOLUTION_URL=http://localhost:18080

# Admin ops — GET /api/admin/evolution/health (header X-Admin-Api-Key) ou JWT autenticado
ADMIN_API_KEY=
# Evolution API — mesma chave que AUTHENTICATION_API_KEY / API_TOKEN na Evolution (Compose usa típicamente esta):
EVOLUTION_API_KEY=mude_isto
# Alternativa também lida pelo Spring: EVOLUTION_APIKEY=mesmo_valor
EVOLUTION_INSTANCE=ConsumoEsperto
# Produção Compose: URL pública da Evolution (SERVER_URL no contentor evolution_api) — NÃO use a URL do frontend.
# Sem isto /instance/connect devolve {"count":0} e o QR não aparece na app.
# Ex.: https://consumoesperto.brucew07.com.br:8585  ou  https://consumoesperto.brucew07.com.br/evolution
# Mesmo valor que EVOLUTION_PUBLISH (Compose usa EVOLUTION_SERVER_URL ou EVOLUTION_PUBLISH no SERVER_URL da Evolution)
EVOLUTION_SERVER_URL=https://consumoesperto.brucew07.com.br:8585
EVOLUTION_PUBLISH=https://consumoesperto.brucew07.com.br:8585
# Deixe vazio no Compose para a Evolution obter a versão WhatsApp Web actual (recomendado após update do telemóvel).
# Só preencha se o QR não aparecer: copie a versão no fundo do menu do WhatsApp Web (ex. 2.3000.1033893291).
# CONFIG_SESSION_PHONE_VERSION=
# Opcional: painel Manager (defeito: EVOLUTION_SERVER_URL + /manager)
# EVOLUTION_MANAGER_URL=

# Docker (evoapicloud/evolution-api): Redis segundo env oficial — CACHE_REDIS_URI para o serviço `redis`; não usar só REDIS_HOST/REDIS_ENABLED.
# EVOLUTION_CACHE_REDIS_ENABLED=true
# Seeds no compose: redis://redis:6379/0

# Postgres: password com @ : / ? # deve ir percent-encoded em DATABASE_CONNECTION_URI se montar esse URI á mão.

# Opcional: GET /instance/connect — tentativas e pausa (ms) antes de desistir do QR pela REST (defeitos: 6 e 4000).
# EVOLUTION_PAIRING_CONNECT_RETRIES=6
# EVOLUTION_PAIRING_CONNECT_PAUSE_MS=4000
# Se ce-u* falhar, QR da instância ConsumoEsperto (igual ao Manager): EVOLUTION_PAIRING_FALLBACK_GLOBAL=true
# Uma instância partilhada (como no Manager): EVOLUTION_DEDICATED_INSTANCE_PER_USER=false

# Chaves mestras no servidor (quando o utilizador não tem chaves em UsuarioAiConfig).
# Ordem FIXA: Groq → OpenAI → Claude → Gemini → DeepSeek → Ollama. ATS/Gateway antes de cada chamada.
# Embeddings (RAG): só OpenAI. GITHUB_MODELS_API_KEY não é lida pelo backend.
GROQ_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
# https://aistudio.google.com/apikey — recomendado (plano B gratuito)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
# Compose: rede interna Docker (não use localhost:11999 no backend). Após 1º deploy:
#   docker exec consumo_ollama ollama pull llama3.2
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
# AI_HTTP_READ_TIMEOUT_MS=300000

# AI Token Suppressor (opcional) — reduz tokens antes das chamadas de IA
# TOKEN_SUPPRESSOR_ENABLED=true
# TOKEN_SUPPRESSOR_URL=http://191.252.210.60:8100
# TOKEN_SUPPRESSOR_API_KEY=sua_chave_do_painel_admin
# TOKEN_SUPPRESSOR_STRATEGY=balanced
# TOKEN_SUPPRESSOR_MIN_CHARS=0

# AI Gateway (ATS antes de todo provider; estratégia AUTO)
AI_GATEWAY_ENABLED=true
AI_GATEWAY_AUTO_STRATEGY=true
AI_GATEWAY_DEFAULT_STRATEGY=balanced
AI_GATEWAY_MAX_RETRIES=2
AI_GATEWAY_CACHE_TTL_MS=300000

# AI Router — fallback por categoria de tarefa (desligue router para ordem canónica legada)
AI_ROUTER_ENABLED=true
AI_ROUTER_OLLAMA_EMERGENCY=false
AI_ROUTER_GROQ_ENABLED=true
AI_ROUTER_OPENAI_ENABLED=true
AI_ROUTER_CLAUDE_ENABLED=true
AI_ROUTER_GEMINI_ENABLED=true
AI_ROUTER_DEEPSEEK_ENABLED=true
AI_ROUTER_OLLAMA_ENABLED=false
AI_ROUTER_TRACE_MAX=10000
AI_ROUTER_ALERT_FALLBACK_MAX=0.15
AI_ROUTER_ALERT_LATENCY_INCREASE=0.50
AI_ROUTER_ALERT_STRUCT_INVALID=0.05
AI_ROUTER_ALERT_DAILY_COST_USD=25
AI_ROUTER_ALERT_MIN_SAMPLES=10
AI_ROUTER_ALERT_COOLDOWN_MIN=30

# URL pública do backend (OAuth2 / callbacks); em produção use https://seu-dominio
PUBLIC_APP_URL=http://127.0.0.1:18081

# true = criar Utilizador ao receber WhatsApp de número novo (multi-tenant).
WHATSAPP_AUTO_PROVISION_USER=true
# true = cada utilizador com instância Evolution dedicada ce-u{id} (recomendado; evita «não é possível ligar outro dispositivo» entre contas).
EVOLUTION_DEDICATED_INSTANCE_PER_USER=true
# Opcional: URL que a Evolution chama por instância (Compose: http://backend:8087/api/public/evolution/webhook).
# EVOLUTION_WEBHOOK_BACKEND_URL=
# Segredo do webhook (token na query — obrigatório com auth-required=true). Use valor forte e distinto da API key REST.
EVOLUTION_WEBHOOK_SECRET=mude_para_um_token_longo_e_aleatorio
# Header customizado (alternativa ao token na URL — configure via POST /webhook/set/{instance}):
# EVOLUTION_WEBHOOK_HEADER_NAME=X-ConsumoEsperto-Webhook-Secret
# EVOLUTION_WEBHOOK_QUERY_PARAM=token
# Rollback emergencial se WhatsApp ficar mudo: EVOLUTION_WEBHOOK_AUTH_REQUIRED=false
# Privacidade WhatsApp (recomendado false): alwaysOnline/readMessages true silenciam notificações no telemóvel
# EVOLUTION_ALWAYS_ONLINE=false
# EVOLUTION_READ_MESSAGES=false
# EVOLUTION_READ_STATUS=false
# EVOLUTION_SYNC_FULL_HISTORY=false
# Sessão persistente (evita derrubar Baileys com restarts repetidos)
# EVOLUTION_SESSION_STICKY=true
# Reinício na 1ª ligação — necessário para alwaysOnline/readMessages off surtirem efeito
# EVOLUTION_PRIVACY_RESTART_ON_CONNECT=true
# EVOLUTION_PRIVACY_RESTART_AFTER_APPLY=false
# Presença unavailable — essencial para notificações no telemóvel
# EVOLUTION_PRIVACY_SET_UNAVAILABLE=true
# EVOLUTION_PRIVACY_PRESENCE_REFRESH=true
# EVOLUTION_PRIVACY_PRESENCE_INTERVAL_MS=600000
# EVOLUTION_PRIVACY_PRESENCE_AFTER_MSG_MS=90000
# EVOLUTION_KEEPALIVE_INTERVAL_MS=14400000

# OAuth2 Web (ConsumoEsperto) — mesmo ID que em frontend/src/environments/environment.ts
GOOGLE_CLIENT_ID=593452038228-xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_da_consola
# Google Cloud Console → Credenciais → Cliente OAuth "Aplicativo da Web":
#   Origens JavaScript autorizadas (exatamente o URL do browser, sem barra final):
#     http://localhost:14200
#     https://consumoesperto.brucew07.com.br
#   URIs de redirecionamento (se usar fluxo server-side): http://localhost:18081/api/integracoes/google-calendar/oauth2/callback

# Projeção forecast / benchmark / amortização (opcional — defaults em application.properties)
# CONSUMOESPERTO_FORECAST_DIA_LIMINAR_ANTI_SUSTO=15
# CONSUMOESPERTO_PROVISAO_TOLERANCIA_DEDUP_PCT=10
# CONSUMOESPERTO_PROVISAO_TOLERANCIA_DEDUP_PISO=2.00
# consumoesperto.simulacao.meses-janela=6
# consumoesperto.simulacao.meses-minimo-divisor=1
# consumoesperto.projecao.burn-dias-amostra=31
# EVOLUTION_WEBHOOK_APIKEY_REQUIRED=true
# CONSUMOESPERTO_AI_RATE_LIMIT_REQUESTS_PER_MINUTE=30
# CONSUMOESPERTO_SALDO_INTEGRIDADE_AUTO_CORRIGIR=false

# E.D.I.T.H. — Enhanced Distributed Intelligence & Task Hub (gateway cognitivo; desligado por padrão)
EDITH_ENABLED=false
EDITH_BASE_URL=
EDITH_API_KEY=
EDITH_CALLBACK_SECRET=
# EDITH_APPLICATION=CONSUMO_ESPERTO
# EDITH_PROJECT=CONSUMO_ESPERTO
# EDITH_REQUEST_TIMEOUT_MS=30000
# EDITH_TASK_TIMEOUT_MS=300000
# Callback interno (Docker): http://consumo_backend:8087/api/internal/edith/tools
# EDITH_CALLBACK_URL=http://consumo_backend:8087/api/internal/edith/tools

# Captura automática de gastos (MacroDroid / Atalhos iOS)
MOBILE_CAPTURE_ENABLED=false
# MOBILE_CAPTURE_ANDROID_ENABLED=true
# MOBILE_CAPTURE_IOS_ENABLED=true
# MOBILE_CAPTURE_EDITH_CLASSIFICATION_ENABLED=true
# MOBILE_CAPTURE_INGESTION_URL=https://consumoesperto.brucew07.com.br
# MOBILE_CAPTURE_REQUIRE_HTTPS=true

# Reparo de dados financeiros — fail-closed: só ligue APÓS backup, aplique e desligue de novo
# SALDO_REPARO_ENABLED=false

# Audit trail de saldo — retenção em dias do expurgo (padrão 730)
# SALDO_AUDIT_RETENTION_DAYS=730

# J.A.R.V.I.S. — performance (cache, multi-turno, métricas, timeout de parse)
# JARVIS_CONTEXTO_CACHE_TTL_SECONDS=90
# JARVIS_MARKET_CACHE_TTL_SECONDS=7200
# JARVIS_CONVERSA_JANELA_TTL_SECONDS=3600
# JARVIS_CONVERSA_JANELA_MAX_TROCAS=6
# JARVIS_ACK_LONG_OPERATION_MS=3000
# JARVIS_PARSE_READ_TIMEOUT_MS=25000
# JARVIS_METRICS_SAMPLE_SIZE=500

# Alertas operacionais (divergência de saldo / auth do webhook rejeitada).
# Baseline = log ERROR [ALERTA-OP]; opcionalmente POST JSON num webhook (ex.: ntfy, Discord, MacroDroid):
# ALERTAS_WEBHOOK_ENABLED=true
# ALERTAS_WEBHOOK_URL=https://seu-endpoint-de-alertas
# ALERTAS_COOLDOWN_MINUTES=15

# Memória semântica J.A.R.V.I.S. (captura automática, dedupe, RAG híbrido, ciclo de vida)
# MEMORIA_CAPTURA_AUTOMATICA_ENABLED=true    # extrai memórias das conversas sem «anote isso»
# MEMORIA_DEDUPE_SIMILARIDADE=0.90           # >= disso, reforça memória existente em vez de duplicar
# MEMORIA_SUPERACAO_SIMILARIDADE=0.78        # >= disso, preferência/plano novo SUPERA o antigo (mesma categoria)
# MEMORIA_SUPERACAO_SIMILARIDADE_SEM_CATEGORIA=0.88  # limiar mais alto quando uma das memórias não tem categoria
# MEMORIA_RAG_LIMITE_CONTEXTO=5              # máximo de memórias injetadas por conversa
# MEMORIA_RAG_MEIA_VIDA_DIAS=90              # meia-vida do peso de recência no score híbrido
# MEMORIA_HABITO_MIN_OCORRENCIAS=5           # ocorrências mínimas para declarar hábito
# MEMORIA_HABITO_MIN_DIAS_DISTINTOS=3        # em dias distintos
# MEMORIA_HABITO_JANELA_DUPLICATA_MIN=30     # mesma descrição em <= N min = duplicata, não hábito
# MEMORIA_DECAIMENTO_MENSAL=0.05             # queda de confiança por mês sem reforço (inferidas)
# MEMORIA_CONFIANCA_PISO=0.25                # abaixo disso a memória inferida é arquivada
# MEMORIA_CONSOLIDACAO_MIN_CLUSTER=6         # nº mínimo de memórias do mesmo tema para consolidar
# MEMORIA_CONSOLIDACAO_SIMILARIDADE=0.85     # similaridade mínima para pertencer ao cluster
